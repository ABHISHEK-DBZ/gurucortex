# ZenForge Configuration
# Copy this to .env and adjust as needed

# Application
DEBUG=false

# LLM Configuration (Groq or Ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
INCLUDE_THINKING_IN_CHAT=true

# Ollama Configuration (local LLM fallback)
# For Docker: http://host.docker.internal:11434
# For WSL:    http://172.29.240.1:11434
# For native: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# Embedding Model (downloads once, then cached locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=50

# RAG Configuration
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.3
